# Copy to .env on Debian. Never commit .env.
# Lowercase ghcr.io/<owner>/<repository>, without a trailing slash.
IMAGE_PREFIX=ghcr.io/zyaosheng/xianyu-auto-reply
# Use the full commit SHA from an entirely successful Actions run.
IMAGE_TAG=sha-REPLACE_WITH_FULL_COMMIT_SHA
FRONTEND_PORT=9000
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
REDIS_PASSWORD=
INTERNAL_API_TOKEN=

# Disable upstream advertisements and announcements.
ENABLE_REMOTE_ADS=false
ENABLE_REMOTE_ANNOUNCEMENTS=false
ENABLE_REMOTE_POPUP_ANNOUNCEMENTS=false
